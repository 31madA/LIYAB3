{"id":1,"name":"CH3 S7 The Trial","x":7,"y":6,"note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":117,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["By the time you reached Maragondon, Bonifacio and his"]},{"code":401,"indent":0,"parameters":["brother was already being tried."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["You met up with Florante, who was fortunate enough to"]},{"code":401,"indent":0,"parameters":["be alive, and decided to watch and witness the trial."]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Prosecutor>Andres Bonifacio and Procopio Bonifacio are charged "]},{"code":401,"indent":0,"parameters":["with treason and sedition against the revolutionary "]},{"code":401,"indent":0,"parameters":["government..."]},{"code":213,"indent":0,"parameters":[2,8,true]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio>Treason? "]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio>I founded the Katipunan. I wrote its rules. I led you "]},{"code":401,"indent":0,"parameters":["at the Cry of Balintawak. And now I am the traitor?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio>I have not changed. You have changed. The revolution I "]},{"code":401,"indent":0,"parameters":["started — it was not for power. It was for the country."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio>If defending the Katipunan is treason — if opposing "]},{"code":401,"indent":0,"parameters":["fraud is sedition — then yes, I am guilty. But not to "]},{"code":401,"indent":0,"parameters":["the country. Only to you."]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The Council of War deliberates. When the judges return, "]},{"code":401,"indent":0,"parameters":["their faces are grim."]},{"code":222,"indent":0,"parameters":[]},{"code":213,"indent":0,"parameters":[4,1,true]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<General Mariano Riego de Dios>The council finds Andres Bonifacio and Procopio "]},{"code":401,"indent":0,"parameters":["Bonifacio guilty of treason and sedition. The sentence "]},{"code":401,"indent":0,"parameters":["- death."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The room stirs. Someone gasps. Bonifacio shows no "]},{"code":401,"indent":0,"parameters":["reaction. He was expecting this."]},{"code":201,"indent":0,"parameters":[0,92,11,5,0,0]},{"code":123,"indent":0,"parameters":["A","0"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":f