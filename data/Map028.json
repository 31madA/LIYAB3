t":null},{"code":2,"indent":null},{"code":2,"indent":null},{"code":2,"indent":null},{"code":4,"indent":null},{"code":2,"indent":null},{"code":4,"indent":null},{"code":2,"indent":null},{"code":38,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":40,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":37,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":29,"parameters":[5],"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":17,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":38,"indent":null}]},{"code":230,"indent":0,"parameters":[20]},{"code":213,"indent":0,"parameters":[2,6,false]},{"code":230,"indent":0,"parameters":[100]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Scout> Supremo! Tandang Sora — she was captured last night by the Guardia Civil."]},{"code":213,"indent":0,"parameters":[3,1,false]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio> Where did they take her?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Scout> To Pasong Putik first. Then to Bilibid. Supremo — they questioned her about us. She did not speak."]},{"code":205,"indent":0,"parameters":[3,{"list":[{"code":16,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":16,"indent":null}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(Bonifacio closes his eyes. For a moment his face shows something human — a man who has just learned that an old woman suffered for his cause. Then the mask returns.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio> You have heard the news. Tandang Sora — an old woman — did not speak even before the enemy. She did not betray our society. Ask yourselves: if we are captured, will we do the same?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> (low, still walking) She knew what was waiting for her. Eighty-four years old — and she did not speak. If she could do that, then we can do this."]},{"code":123,"indent":0,"parameters":["B",0]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(The column reaches the outskirts of San Juan del Monte. Ahead, at the top of a low hill, stands El Polvorin — a squat stone powder magazine, a red Spanish flag hanging limp above it. Guardia Civil patrol the perimeter. A cannon is positioned near the entrance.)"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio> Brothers. Look at that place. Behind that wall are the weapons we need — gunpowder, bullets, rifles. Not for us, but for the brothers who will fight after us."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio> Many of us will not see the sunset today. I know that. You know that. But remember this: this fight is not only for us. It is for those not yet born."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Andres Bonifacio> No retreat. No turning back. Now."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["(He draws his bolo. The metal catches the morning light. He turns and walks toward the fort. The column follows — not with a war cry, but with the heavy, determined silence of men who have already accepted what comes next.)"]},{"code":250,"indent":0,"parameters":[{"name":"Sword1","volume":80,"pitch":100,"pan":0}]},{"code":123,"indent":0,"parameters":["C",0]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Florante> Stay close to me. Do not stop. If you stop — I will make sure you get back up."]},{"code":221,"indent":0,"parameters":[]},{"code":316,"indent":0,"parameters":[0,0,0,0,98,false]},{"code":318,"indent":0,"parameters":[0,0,0,11]},{"code":301,"indent":0,"parameters":[0,8,false,true]},{"code":601,"indent":0,"parameters":[]},{"code":250,"indent":1,"parameters":[{"name":"Decision2","volume":75,"pitch":60,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Florante>(breathing hard) More are coming. We need "]},{"code":401,"indent":1,"parameters":["to enter the fort before they arrive."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["(In the distance, drums. Spanish reinforcements are "]},{"code":401,"indent":1,"parameters":["approaching. The war does not end here.)"]},{"code":122,"indent":1,"parameters":[10,10,0,0,100]},{"code":221,"indent":1,"parameters":[]},{"code":201,"indent":1,"parameters":[0,29,6,0,2,0]},{"code":121,"indent":1,"parameters":[14,14,0]},{"code":123,"indent":1,"parameters":["D",0]},{"code":0,"indent":1,"parameters":[]},{"code":603,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["\\n<Floran